// Cloudflare Workers config for FoodIsHard (the hosted, multi-household version).
// The Home Assistant app ignores this file. Set-up steps: CLOUDFLARE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foodishard",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "foodishard/app/static",
    "binding": "ASSETS",
    // every request goes through the Worker first, so sign-in is checked for the app files too
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "HOUSEHOLD", "class_name": "Household" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Household"] }],
  // weekly ONS food-price check (Mondays 06:17 UTC)
  "triggers": { "crons": ["17 6 * * 1"] },
  // ACCESS_TEAM, ACCESS_AUD and HOUSEHOLDS are set in the dashboard; keep them on each deploy
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
